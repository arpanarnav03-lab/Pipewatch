# Copy to .env and adjust. Never commit .env.
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
# synthetic = offline demo data; open_meteo = live public weather API (no key needed)
PIPEWATCH_SOURCE=synthetic
# Short interval so alerts are easy to observe in a demo; use 60 in real use
PIPEWATCH_RUN_INTERVAL_MINUTES=2
# Enables POST /pipelines/{name}/run?inject=... (keep false outside demos)
PIPEWATCH_ALLOW_FAULT_INJECTION=true
PIPEWATCH_LOG_LEVEL=INFO
